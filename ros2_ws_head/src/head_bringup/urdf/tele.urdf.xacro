<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tele_humanoid">



  <xacro:property name="pan_joint_z" value="-0.11" />
  <xacro:property name="tilt_joint_z" value="-0.01" />
  
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5)*m*r*r}" ixy="0" ixz="0" iyy="${(2/5)*m*r*r}" iyz="0" izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <link name="base_link"/>

  <joint name="base_to_tele_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tele_torso_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tele_torso_link">
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0"/> 
      <geometry><box size="0.2 0.2 0.6"/></geometry>
    </collision>
    <xacro:box_inertia m="1.0" x="0.2" y="0.2" z="0.6"/>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
      <geometry><mesh filename="package://head_bringup/meshes/lower_bottom.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tele_grey"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
      <geometry><mesh filename="package://head_bringup/meshes/upper_bottom.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tele_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
      <geometry><mesh filename="package://head_bringup/meshes/mid_section.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tele_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
      <geometry><mesh filename="package://head_bringup/meshes/chest.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tele_grey"/>
    </visual>
  </link>

  <joint name="tele_pan_joint" type="revolute">
    <parent link="tele_torso_link"/>
    <child link="tele_neck_link"/>
    <origin xyz="0 0 ${pan_joint_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <link name="tele_neck_link">
    <visual>
      <origin xyz="-0.02 0 0" rpy="0 0 1.57"/>
      <geometry><mesh filename="package://head_bringup/meshes/head_body_joint.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tele_blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
    <collision>
       <origin xyz="0 0 0.025" rpy="0 0 0"/>
       <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="0.05" h="0.05"/>
  </link>

  <joint name="tele_tilt_joint" type="revolute">
    <parent link="tele_neck_link"/>
    <child link="tele_head_link"/>
    <origin xyz="0 0 ${tilt_joint_z}" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <link name="tele_head_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
      <geometry><mesh filename="package://head_bringup/meshes/head.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="tele_grey"/> 
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/> 
      <geometry><cylinder radius="0.1" length="0.15"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="1.0" r="0.1" h="0.15"/>
  </link>

  <joint name="tele_sensor_joint" type="fixed">
    <parent link="tele_head_link"/>
    <child link="tele_camera_link"/>
    <origin xyz="0.11 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="tele_camera_link">
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="tele_blue"/>
    </visual>
    <collision>
       <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <xacro:sphere_inertia m="0.05" r="0.01"/>
  </link>


</robot>
