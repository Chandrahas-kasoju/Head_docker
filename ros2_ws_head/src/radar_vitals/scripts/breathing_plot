#!/usr/bin/env python3
"""Show live chest movement and breathing rate from radar_vitals_node. Close the window to stop."""
from collections import deque
import math
import time

import matplotlib.pyplot as plt
import numpy as np
import rclpy
from rclpy.node import Node
from radar_vitals.msg import VitalSigns
from std_msgs.msg import Float32MultiArray

FRAME_RATE_HZ = 20.0  # Set by the frame period in cfg/vitals_iwr6843aop.cfg
RATE_HISTORY_S = 180
SURFACE, TEXT, MUTED, GRID, LINE = '#fcfcfb', '#0b0b0b', '#52514e', '#e4e3df', '#2a78d6'


def status_text(vitals):
    if vitals.warming_up:
        return 'Warming up: stay still for about 15 s'
    if not vitals.person_detected:
        return 'No person detected'
    if vitals.motion_detected:
        return 'Movement detected: reading on hold'
    if math.isnan(vitals.breathing_rate_bpm):
        return f'Person at {vitals.range_m:.2f} m: no rate yet'
    return (f'{vitals.breathing_rate_bpm:.1f} breaths/min   confidence {vitals.breathing_confidence:.2f}'
            f'   range {vitals.range_m:.2f} m')


class BreathingPlot(Node):

    def __init__(self):
        super().__init__('breathing_plot')
        self.motion = None
        self.vitals = None
        self.rates = deque(maxlen=RATE_HISTORY_S)
        self.started = time.time()
        self.create_subscription(VitalSigns, '/radar_vitals/vital_signs', self.on_vitals, 10)
        self.create_subscription(Float32MultiArray, '/radar_vitals/breathing_motion_mm', self.on_motion, 10)

    def on_vitals(self, msg):
        self.vitals = msg
        self.rates.append((time.time() - self.started, msg.breathing_rate_bpm))

    def on_motion(self, msg):
        self.motion = np.array(msg.data)


def make_figure():
    plt.rcParams.update({'font.size': 12, 'text.color': TEXT, 'axes.labelcolor': MUTED,
                         'xtick.color': MUTED, 'ytick.color': MUTED, 'axes.edgecolor': GRID})
    fig, (chest_ax, rate_ax) = plt.subplots(2, 1, figsize=(11, 7), height_ratios=[3, 2], facecolor=SURFACE)
    fig.canvas.manager.set_window_title('Radar breathing')
    for ax in (chest_ax, rate_ax):
        ax.set_facecolor(SURFACE)
        ax.grid(True, color=GRID, linewidth=0.8)
        ax.spines[['top', 'right']].set_visible(False)
    chest_ax.set_title('Chest movement: each wave is one breath', loc='left')
    chest_ax.set_xlabel('Seconds ago')
    chest_ax.set_ylabel('Movement (mm)')
    chest_ax.set_xlim(-30, 0)
    rate_ax.set_title('Radar breathing rate', loc='left')
    rate_ax.set_xlabel('Seconds since start')
    rate_ax.set_ylabel('Breaths per minute')
    rate_ax.set_ylim(0, 40)
    return fig, chest_ax, rate_ax


def main():
    rclpy.init()
    node = BreathingPlot()
    fig, chest_ax, rate_ax = make_figure()
    chest_line, = chest_ax.plot([], [], color=LINE, linewidth=2)
    rate_line, = rate_ax.plot([], [], color=LINE, linewidth=2)
    status = fig.text(0.01, 0.97, 'Waiting for radar...', fontsize=15, fontweight='bold', va='top')
    fig.tight_layout(rect=(0, 0, 1, 0.93))

    try:
        while plt.fignum_exists(fig.number) and rclpy.ok():
            rclpy.spin_once(node, timeout_sec=0.05)
            if node.motion is not None:
                chest_line.set_data((np.arange(len(node.motion)) - len(node.motion) + 1) / FRAME_RATE_HZ, node.motion)
                limit = max(1.0, 1.2 * float(np.abs(node.motion).max()))
                chest_ax.set_ylim(-limit, limit)
            if node.rates:
                times, values = zip(*node.rates)
                rate_line.set_data(times, values)
                rate_ax.set_xlim(max(0, times[-1] - RATE_HISTORY_S), max(60, times[-1]))
            if node.vitals is not None:
                status.set_text(status_text(node.vitals))
            plt.pause(0.2)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
