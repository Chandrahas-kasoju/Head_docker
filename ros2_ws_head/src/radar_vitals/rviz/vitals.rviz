Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.5 m)
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane: XY
      Cell Size: 0.5
      Plane Cell Count: 10
      Color: 90; 90; 90
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Radar
      Enabled: true
      Reference Frame: <Fixed Frame>
      Length: 0.3
      Radius: 0.02
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: All radar points
      Enabled: true
      Topic:
        Value: /radar_vitals/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 170; 170; 170
      Style: Spheres
      Size (m): 0.03
      Alpha: 0.6
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Fine motion points (last 2 s; purple = weak, yellow = strong)
      Enabled: true
      Topic:
        Value: /radar_vitals/motion_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: Intensity
      Channel Name: power_db
      Autocompute Intensity Bounds: false
      Min Intensity: 6
      Max Intensity: 30
      Use rainbow: false
      Invert Rainbow: false
      Min Color: 90; 60; 140
      Max Color: 250; 220; 60
      Style: Spheres
      Size (m): 0.05
      Alpha: 0.8
      Decay Time: 2
      Position Transformer: XYZ
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Breathing (blue = chest in, orange = chest out)
      Enabled: true
      Topic:
        Value: /radar_vitals/breathing_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: Intensity
      Channel Name: breathing_mm
      Autocompute Intensity Bounds: false
      Min Intensity: -1.5
      Max Intensity: 1.5
      Use rainbow: false
      Invert Rainbow: false
      Min Color: 42; 120; 214
      Max Color: 235; 104; 52
      Style: Spheres
      Size (m): 0.2
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: radar_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 4.5
      Focal Point:
        X: 1.2
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 3.0
      Near Clip Distance: 0.01
Window Geometry:
  Height: 800
  Width: 1200
